# Copy to .env at the repo root: `make env`.
#
# This file is the shared baseline for the whole monorepo. Settings resolve in
# this order, each layer overriding the one before it:
#
#   1. this file, as <repo root>/.env
#   2. apps/api/.env          — optional, for service-local overrides
#   3. real environment variables and docker compose
#
# Never commit a real .env: it is gitignored, .env.example is not.

# ─── mission control (apps/web) ───────────────────────────────────────────────
# FastAPI origin the Next server proxies /api/* to. docker compose overrides
# this with http://api:8000. For local dev see apps/web/.env.local.example.
API_ORIGIN=http://localhost:8000

# ─── runtime ──────────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO
WEB_ORIGINS=http://localhost:3000

# ─── storage ──────────────────────────────────────────────────────────────────
# Local/dev default (no services needed):
DATABASE_URL=sqlite+aiosqlite:///./phoneops.db
# Docker compose:
# DATABASE_URL=postgresql+asyncpg://phoneops:phoneops@postgres:5432/phoneops
# REDIS_URL=redis://redis:6379/0
AUTO_CREATE_SCHEMA=true

# ─── CALL-E ───────────────────────────────────────────────────────────────────
# mock -> deterministic scripted carriers (tests, CI, offline dev)
# http -> CALL-E Developer API   (POST /v1/calls, GET /v1/calls/{id})
# cli  -> local `calle` CLI / MCP tools (plan_call, run_call, get_call_run)
CALLE_MODE=mock
CALLE_BASE_URL=
CALLE_API_KEY=
# Public URL of POST /api/webhooks/calle. Unset -> PHONEOPS polls instead.
CALLE_WEBHOOK_URL=
CALLE_WEBHOOK_SECRET=
# Destination country. CALL-E serves 42 countries — Morocco (MA) is NOT one of
# them, so +212 numbers are accepted by the API and then fail per attempt.
# Supported: AE AU BD BR BW CA CM DE EG ES FI FR GB GH HN ID IE IL IN JP KE LK
# MX MY MZ NA NG NL OM PH PK PL SA SG TH TN TR TW UA US VN ZA
CALLE_DEFAULT_REGION=FR
# The operating timezone a cutoff like 17:30 belongs to - the warehouse wall
# clock, not the server's. Set it to where the operation runs, e.g.
# Africa/Casablanca or America/Chicago. Leave UTC and the demo stays coherent
# in any browser.
MISSION_TIMEZONE=UTC
CALLE_DEFAULT_LOCALE=fr-FR
CALLE_CLI_BIN=calle

# ─── LLM (optional) ───────────────────────────────────────────────────────────
# The full recovery loop runs deterministically with LLM_ENABLED=false.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ─── guardrails ───────────────────────────────────────────────────────────────
MAX_REPLANS=3
MAX_CALL_RETRIES=2
MAX_OPERATIONS_PER_MISSION=8
APPROVAL_COST_INCREASE_PCT=15
EVIDENCE_TTL_MINUTES=120
# Shortest window worth attempting a phone recovery in. Below it PHONEOPS
# escalates instead of calling people about an outcome it cannot affect.
MIN_RECOVERY_WINDOW_SECONDS=120

# ─── controlled PSTN endpoints (test harness, not the product) ────────────────
# Answers CALL-E's calls as the demo carriers, so the scenario is reproducible
# without two people sitting by a phone. Off by default: it answers real calls.
# The carrier's answer still travels the long way — spoken over the network,
# heard by CALL-E — or CALL-E stops being load-bearing.
TELNYX_SIM_ENABLED=false
TELNYX_API_KEY=
# Base64 Ed25519 key from the Telnyx portal. Empty disables verification, which
# is acceptable only while first wiring the webhook up.
TELNYX_PUBLIC_KEY=
TELNYX_VOICE=female
TELNYX_LANGUAGE=en-US

# ─── flagship demo ────────────────────────────────────────────────────────────
DEMO_MODE=true
# THE counterfactual knob. 18:00 violates the 17:30 cutoff -> replan -> Carrier C.
# 16:00 keeps Carrier B and no second call is ever created.
DEMO_CARRIER_B_PICKUP=18:00
DEMO_CALL_LATENCY_SECONDS=1.5
# Real numbers when CALLE_MODE=http (E.164). Never commit real numbers.
# Telnyx DIDs, both attached to the same application so they reach the same
# webhook. The variable is *_PHONE, not *_NUMBER.
DEMO_CARRIER_B_PHONE=+15550100001
DEMO_CARRIER_C_PHONE=+15550100002
DEMO_CARRIER_D_PHONE=+15550100003
